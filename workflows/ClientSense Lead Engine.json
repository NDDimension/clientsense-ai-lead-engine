    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body.data;\nconst fields = payload.fields || [];\n\nconst getField = (label) => fields.find((f) => f.label === label);\n\nconst getValue = (label) => {\n  const field = getField(label);\n  if (!field) return \"\";\n  if (Array.isArray(field.value) && field.options) {\n    const selectedId = field.value[0];\n    const option = field.options.find((o) => o.id === selectedId);\n    return option ? option.text : selectedId;\n  }\n  return field.value ?? \"\";\n};\n\nreturn [\n  {\n    json: {\n      fullName: getValue(\"Full Name\"),\n      email: getValue(\"Email\"),\n      companyOrProjectName: getValue(\"Company/Project Name\"),\n      budget: getValue(\"Budget\"),\n      timeline: getValue(\"Timeline\"),\n      projectDescription: getValue(\"Project Description\"),\n      howDidYouFindMe: getValue(\"How did you find me?\"),\n      formName: payload.formName,\n      responseId: payload.responseId,\n      submittedAt: payload.createdAt,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        -336
      ],
