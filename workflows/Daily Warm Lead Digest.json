    {
      "parameters": {
        "jsCode": "const leads = $input.all();\n\nlet message = `\n<h2>📋 Warm Leads Needing Follow-up</h2>\n`;\n\nfor (const lead of leads) {\n  message += `\n  <hr>\n  <p>\n    <strong>Name:</strong> ${lead.json[\"Full Name\"]}<br>\n    <strong>Email:</strong> ${lead.json[\"Email\"]}<br>\n    <strong>Company:</strong> ${lead.json[\"Company/Project Name\"]}<br>\n    <strong>Budget:</strong> ${lead.json[\"Budget\"]}<br>\n    <strong>Reasoning:</strong> ${lead.json[\"Reasoning\"]}<br>\n  </p>\n  `;\n}\n\nreturn [\n  {\n    json: {\n      digest: message,\n      count: leads.length,\n    },\n  },\n];"
      },
